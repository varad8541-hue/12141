# Required
DISCORD_TOKEN=
# Instant command sync when set, otherwise global sync (can take an hour)
GUILD_ID=

# Comma separated Discord user IDs with full access
OWNER_IDS=
# A role that also counts as staff
STAFF_ROLE_ID=
# Optional role handed out when somebody receives their first instance
MEMBER_ROLE_ID=
# Optional channel that receives an audit line for every operator action
AUDIT_CHANNEL_ID=

# Branding
BRAND=CloudBox

# LXD
STORAGE_POOL=default
DEFAULT_IMAGE=images:ubuntu/24.04
IMAGES=Ubuntu 24.04 LTS=images:ubuntu/24.04,Ubuntu 22.04 LTS=images:ubuntu/22.04,Debian 12 Bookworm=images:debian/12,Debian 13 Trixie=images:debian/13

# Public hostname/IP shown in port-forward instructions. Auto-detected when blank.
PUBLIC_IP=
PORT_RANGE=20000-40000

# 0 disables leases
DEFAULT_TTL_HOURS=0
# Let members create their own boxes (subject to /staff quota-set)
SELF_SERVICE=false
# Only honoured for staff, and only when true
ALLOW_PRIVILEGED=false
MAX_INSTANCES_STAFF=25

# pinggy.io reverse tunnels
PINGGY_TOKEN=
PINGGY_HOST=free.pinggy.io

# Where the database and encryption key live
CLOUDBOX_DATA=./data
